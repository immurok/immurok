.DS_Store
Thumbs.db

# === Build artifacts ===
.build/
build/
dist/
*.o
*.so
*.dylib
*.a
*.d
*.su
# *.d above targets C dependency files; systemd drop-in directories share the
# suffix and must stay tracked.
!**/tmpfiles.d/

# === App (macOS / Swift) ===
app-macos/.build/
app-macos/.swiftpm/
app-macos/Resources/*.pkg
app-macos/immurok.app/
app-macos/.sign-identity

# === Firmware (CH592F) ===
firmware/SDK/
firmware/build/
ota/iap/build/
ota/jumpapp/build/


# === OTA keys ===
# Intentionally NOT ignored: ota_keys.h, ota_keys.py, ota/ota_ec_private.pem are
# versioned in the PRIVATE monorepo (origin = 192.168.1.98). scripts/sync-github.sh
# excludes all three from the public GitHub repos. The EC private key can forge
# firmware for the whole fleet — never push the tree to a github remote directly.

